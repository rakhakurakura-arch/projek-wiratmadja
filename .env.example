# App Settings
JWT_SECRET=ganti_dengan_random_string_panjang
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Turso Database Connection (SQLite Cloud)
# Dapatkan dari dashboard Turso (turso.tech) atau lewat Turso CLI:
# 1. `turso db create wiratmadja-db`
# 2. `turso db show wiratmadja-db --url` -> TURSO_DATABASE_URL (misal: libsql://wiratmadja-db-username.turso.io)
# 3. `turso db tokens create wiratmadja-db` -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

